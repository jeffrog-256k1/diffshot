{
  "name": "@jeffrog-256k1/diffshot",
  "version": "0.1.0",
  "description": "Two URLs. Three viewports. One shareable visual change report.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "bin": {
    "diffshot": "src/cli.mjs"
  },
  "scripts": {
    "compare": "node src/cli.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node scripts/test-browser.mjs",
    "demo:capture": "node scripts/capture-demo.mjs",
    "build": "node scripts/build.mjs",
    "dev": "node scripts/serve.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "pixelmatch": "8.0.0",
    "playwright": "1.64.0",
    "pngjs": "7.0.0"
  },
  "devDependencies": {
    "prettier": "3.9.10"
  }
}
